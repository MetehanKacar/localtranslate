<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
  </ItemGroup>

  <!-- Test the app's real text-reading code, not a copy. -->
  <ItemGroup>
    <Compile Include="..\..\Native.cs" Link="App\Native.cs" />
    <Compile Include="..\..\Loc.cs" Link="App\Loc.cs" />
    <Compile Include="..\..\Settings.cs" Link="App\Settings.cs" />
    <Compile Include="..\..\Translator.cs" Link="App\Translator.cs" />
    <Compile Include="..\..\Text\*.cs" Link="App\Text\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
